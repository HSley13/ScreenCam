<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>ScreenCam</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- Privacy strings: macOS refuses camera/mic access (and may crash the app) without them. -->
    <key>NSCameraUsageDescription</key>
    <string>ScreenCam shows your camera in a bubble and records it together with your screen.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>ScreenCam records your voice from the microphone you choose.</string>
    <!-- Lets iPhone Continuity Camera show up in the camera list on macOS 14+. -->
    <key>NSCameraUseContinuityCameraDeviceType</key>
    <true/>

    <!-- ".screencam" projects: Finder shows each project folder as one document with the
         ScreenCam icon, and double-clicking it opens it in ScreenCam's editor. ("Show Package
         Contents" still reveals screen.mp4 / camera.mp4 / project.json inside.) -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.hsley13.screencam.project</string>
            <key>UTTypeDescription</key>
            <string>ScreenCam Project</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.package</string>
                <string>public.composite-content</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>screencam</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>ScreenCam Project</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSTypeIsPackage</key>
            <true/>
            <key>CFBundleTypeIconFile</key>
            <string>${MACOSX_BUNDLE_ICON_FILE}</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.hsley13.screencam.project</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
